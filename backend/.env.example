# "Session pooler" connection string of the Supabase project (Connect → Session pooler).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
# Secret key of the project (sb_secret_… or service_role). Never goes in the frontend.
SUPABASE_SECRET_KEY=
# Private bucket for payment evidence (created with npm run create-evidence-bucket).
EVIDENCE_BUCKET=payment-evidence
PANEL_ORIGIN=http://localhost:3000
PORT=8787
# Only in production (Vercel): secret of the daily cron that keeps Supabase awake. 16 or more characters.
# CRON_SECRET=
