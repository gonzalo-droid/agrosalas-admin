# Local development: Supabase running in Docker (npm run db:start). Run npm run db:status for the keys.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# "Secret key" printed by npm run db:status. Never goes in the frontend.
SUPABASE_SECRET_KEY=
# Production (cloud project): replace the three values above with these.
# "Session pooler" connection string (Connect → Session pooler).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=<sb_secret_… or service_role key of the project>
# Private bucket for payment evidence (created with npm run create-evidence-bucket).
EVIDENCE_BUCKET=payment-evidence
PANEL_ORIGIN=http://localhost:3000
PORT=8787
# Only in production (Vercel): secret of the daily cron that keeps Supabase awake. 16 or more characters.
# CRON_SECRET=
