# Local development: Supabase running in Docker (npm run db:start). Run npm run db:status for the keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" printed by npm run db:status. The secret key never goes here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8787
# Production (cloud project): replace the values above with these.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<the project's publishable key>
# NEXT_PUBLIC_API_URL=https://<the API domain>
